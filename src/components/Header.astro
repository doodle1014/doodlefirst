<style>
header {
	margin: 0;
	padding: 0 1rem;
	background: white;
}

nav {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

h2 {
	margin: 0;
	font-size: 1.5rem;
}

h2 a {
	text-decoration: none;
	color: inherit;
}

.social-links {
	display: flex;
	gap: 1em;
	flex-shrink: 0; /* 아이콘 찌그러짐 방지 */
}

/* 📱 모바일 전용 설정 (600px 이하) */
@media (max-width: 600px) {
	nav {
		height: 70px; /* 모바일에서 높이 명시적 확보 */
		flex-wrap: nowrap; /* 한 줄 고정 */
	}

	h2 {
		font-size: 1.1rem; /* 제목 크기 축소 */
	}

	.social-links {
		gap: 0.7em; /* 간격 축소 */
	}

	.social-links svg {
		width: 20px; /* 아이콘 크기 축소 */
		height: 20px;
	}
}
</style>